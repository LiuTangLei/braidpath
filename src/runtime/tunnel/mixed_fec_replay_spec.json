  "service_order": "For each integer virtual millisecond: generate due records and timer flush via real encoder; expire queued symbols at ingress age >= 100 ms; admit ready originals then eligible repairs once their per-case service gate opens. Admission is a virtual test shim; actual real sender scheduling is covered separately.",
  "artificial_erasure": {
    "unit": "record id selected from the original's real wire header; identical original ID set for every mode in a case",
    "location": "after virtual admission, before real Receiver",
    "repairs": "No artificial erasure of admitted repair symbols. Budget skipped or expired repairs were never admitted and are separate.",
    "not_matched": "Block numbers and ciphertext ordinals are never treated as equal erasure events across modes."
  },
  "payload_pattern": "BPP2, kind 3 bulk or 2 echo, reserved zero, 16-byte case run_id, sequence=logical record id, signed 64-bit virtual timestamp nanoseconds; remaining bytes=(record_id + kind) % 251.",
