FROM rust:1.90-slim-bookworm

# Build/runtime tools for a dedicated, unpublished Linux test container.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    iproute2 iputils-ping iperf3 ethtool python3 ca-certificates procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
